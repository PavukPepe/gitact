# =====================================================================
# Next.js — Production ENV (шаблон)
# Копируйте в .env.production и заполняйте под свой деплой.
# Эти значения встраиваются в бандл на этапе build (NEXT_PUBLIC_*).
# =====================================================================

# URL бэкенда. Если ходим через Nginx с того же домена — указываем пустую
# строку (все запросы /api/* пойдут на тот же origin) или полный URL.
# Пример VPS без домена: http://1.2.3.4
# Пример с доменом и HTTPS: https://example.com
NEXT_PUBLIC_API_URL=
